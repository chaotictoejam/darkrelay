{
  "name": "darkrelay",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "build:dashboard": "npm run build -w @darkrelay/dashboard",
    "synth": "npm run synth -w @darkrelay/infra",
    "deploy": "npm run build:dashboard && npm exec -w @darkrelay/infra -- cdk deploy --all",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "vite": "7.3.7"
  }
}
