{
  "name": "darkrelay",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "synth": "pnpm --filter @darkrelay/infra synth",
    "deploy": "pnpm build:dashboard && pnpm --filter @darkrelay/infra exec cdk deploy --all",
    "darkrelay": "tsx packages/cli/src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:dashboard": "pnpm --filter @darkrelay/dashboard build"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
